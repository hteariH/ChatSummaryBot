# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username

# Google Gemini API (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# Fallback model used when the primary model returns HTTP 429 (rate limited / quota exhausted)
GEMINI_BACKUP_MODEL=gemini-2.5-flash

# Summary schedule (cron expression, default: daily at 21:00)
SUMMARY_CRON=0 0 21 * * *
