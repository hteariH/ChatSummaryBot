# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username

# Google Gemini API (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Models tried in order; on HTTP 429 (rate limited / quota exhausted) or 404 (model
# unavailable) the request falls through to the next model in the list.
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash

# Summary schedule (cron expression, default: daily at 21:00)
SUMMARY_CRON=0 0 21 * * *
